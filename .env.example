# Analytics configuration. Copy to .env.local (local) or set in the
# Cloudflare Pages project settings (production). Both are optional —
# the corresponding script simply isn't rendered when the value is unset.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Cloudflare Web Analytics token. Cloudflare dashboard →
# Analytics & Logs → Web Analytics → add fboairport.com → copy the token.
NEXT_PUBLIC_CF_BEACON_TOKEN=
